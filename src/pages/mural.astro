---
/**
 * Mural: fotos e vídeos do evento, separados por dia (mesmas abas da Programação).
 * Conteúdo em src/data/mural.ts (fotos: basta colocar na pasta do dia).
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import DayTabs from '../components/ui/DayTabs.astro';
import UnderConstruction from '../components/ui/UnderConstruction.astro';
import { mural, muralHasContent } from '../data/mural';

// versão grande de cada foto, para o lightbox
const days = await Promise.all(
  mural.map(async (d) => ({
    ...d,
    photos: await Promise.all(
      d.photos.map(async (p) => ({ ...p, full: (await getImage({ src: p.src, width: 1600, format: 'webp' })).src })),
    ),
  })),
);
const ghostHeights = ['h-56', 'h-40', 'h-64', 'h-44', 'h-60', 'h-48'];
---

<BaseLayout title="Mural" description="Fotos e vídeos do Hackathon Univassouras Maricá 2026, separados por dia do evento.">
  <section class="pt-32 pb-12 sm:pt-40" aria-labelledby="mural-title">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionTitle
          id="mural-title"
          eyebrow="Mural"
          title="Os melhores momentos do Hackathon"
          lead="Fotos e vídeos de cada dia do evento. Escolha uma data para ver os registros."
        />
        {!muralHasContent && <UnderConstruction class="mb-10 sm:mb-14" />}
      </div>

      <DayTabs days={days} prefix="mural" label="Dias do evento no mural" />

      {
        days.map((d, i) => (
          <div role="tabpanel" id={`mural-panel-${d.id}`} aria-labelledby={`mural-tab-${d.id}`} tabindex="0" hidden={i !== 0} class="panel day-panel">
            <header class="mb-8 flex flex-wrap items-center justify-between gap-3">
              <h2 class="font-display text-2xl font-bold sm:text-3xl">
                {d.weekday}, {d.date.slice(8)} de outubro
              </h2>
              {(d.photos.length > 0 || d.videos.length > 0) && (
                <p class="font-mono text-xs tracking-widest text-stone uppercase">
                  {d.photos.length} {d.photos.length === 1 ? 'foto' : 'fotos'} · {d.videos.length} {d.videos.length === 1 ? 'vídeo' : 'vídeos'}
                </p>
              )}
            </header>

            {d.photos.length === 0 && d.videos.length === 0 ? (
              <div class="relative">
                <div class="masonry opacity-40" aria-hidden="true">
                  {ghostHeights.map((h) => (
                    <div class:list={['ghost-tile', h]}>
                      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
                        <circle cx="12" cy="13" r="3.5" />
                      </svg>
                    </div>
                  ))}
                </div>
                <div class="absolute inset-0 grid place-items-center p-4">
                  <UnderConstruction variant="block" class="max-w-sm bg-ink-2/95 backdrop-blur" hint="As fotos e os vídeos deste dia serão publicados aqui durante e depois do evento." />
                </div>
              </div>
            ) : (
              <>
                {d.videos.length > 0 && (
                  <div class="mb-8 grid gap-4 sm:grid-cols-2">
                    {d.videos.map((v) =>
                      v.youtube ? (
                        <button type="button" class="video yt" data-yt={v.youtube} data-title={v.title} aria-label={`Reproduzir vídeo: ${v.title}`}>
                          <img src={`https://i.ytimg.com/vi/${v.youtube}/hqdefault.jpg`} alt="" loading="lazy" class="size-full object-cover" />
                          <span class="play" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                          </span>
                          <span class="video-title">{v.title}</span>
                        </button>
                      ) : (
                        <figure class="video">
                          <video src={v.file} controls preload="metadata" class="size-full bg-ink object-contain" />
                          <figcaption class="video-title">{v.title}</figcaption>
                        </figure>
                      ),
                    )}
                  </div>
                )}

                {d.photos.length > 0 && (
                  <ul class="masonry" role="list">
                    {d.photos.map((p, k) => (
                      <li class="mb-4 break-inside-avoid">
                        <button
                          type="button"
                          class="photo-btn"
                          data-lightbox={d.id}
                          data-index={k}
                          data-full={p.full}
                          data-caption={p.caption ?? ''}
                          aria-label={`Ampliar foto ${k + 1} de ${d.photos.length}${p.caption ? `: ${p.caption}` : ''}`}
                        >
                          <Image src={p.src} alt={p.caption ?? `Foto ${k + 1} do dia ${d.date.slice(8)}`} widths={[400, 700]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw" class="h-auto w-full" />
                        </button>
                      </li>
                    ))}
                  </ul>
                )}
              </>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Lightbox -->
  <dialog class="lightbox" data-lb aria-label="Foto ampliada">
    <figure class="lb-figure">
      <img data-lb-img alt="" />
      <figcaption data-lb-cap class="lb-cap"></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Fechar">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Foto anterior">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Próxima foto">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </dialog>
</BaseLayout>

<style>
  .masonry {
    columns: 1;
    column-gap: 1rem;
  }
  @media (min-width: 640px) {
    .masonry {
      columns: 2;
    }
  }
  @media (min-width: 1024px) {
    .masonry {
      columns: 3;
    }
  }
  .ghost-tile {
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
    break-inside: avoid;
    border: 1px dashed rgb(255 255 255 / 0.15);
    border-radius: 0.9rem;
    color: var(--color-stone);
    background: repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.025) 0 10px, transparent 10px 20px);
  }
  .photo-btn {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    cursor: zoom-in;
  }
  .photo-btn :global(img) {
    transition: transform 0.6s var(--ease-out-expo);
  }
  .photo-btn:hover :global(img) {
    transform: scale(1.04);
  }

  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: var(--color-ink);
  }
  .yt {
    cursor: pointer;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    translate: -50% -50%;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-wine), var(--color-brick));
    box-shadow: 0 10px 30px -5px rgb(0 0 0 / 0.6);
    transition: transform 0.3s var(--ease-out-expo);
  }
  .yt:hover .play {
    transform: scale(1.1);
  }
  .video-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1rem 0.8rem;
    background: linear-gradient(transparent, rgb(6 11 24 / 0.9));
    font-family: var(--font-display);
    font-weight: 700;
    text-align: left;
    pointer-events: none;
  }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-paper);
  }
  .lightbox::backdrop {
    background: rgb(6 11 24 / 0.94);
    backdrop-filter: blur(6px);
  }
  .lb-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    height: 100%;
    padding: 4rem 1rem;
  }
  .lb-figure img {
    max-width: min(100%, 1400px);
    max-height: calc(100dvh - 9rem);
    border-radius: 0.75rem;
    object-fit: contain;
  }
  .lb-cap {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-stone);
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 999px;
    background: rgb(11 20 40 / 0.8);
    cursor: pointer;
  }
  .lb-btn:hover {
    border-color: var(--color-rose);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }
  @media (max-width: 640px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
</style>

<script>
  // --- Lightbox: navega entre as fotos do mesmo dia ---
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    let group: HTMLButtonElement[] = [];
    let idx = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (i: number) => {
      idx = (i + group.length) % group.length;
      const b = group[idx];
      img.src = b.dataset.full!;
      img.alt = b.dataset.caption || `Foto ${idx + 1} de ${group.length}`;
      cap.textContent = `${b.dataset.caption ? b.dataset.caption + ' · ' : ''}${idx + 1} / ${group.length}`;
    };

    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((b) => {
      b.addEventListener('click', () => {
        group = [...document.querySelectorAll<HTMLButtonElement>(`[data-lightbox="${b.dataset.lightbox}"]`)];
        opener = b;
        show(Number(b.dataset.index));
        dlg.showModal();
      });
    });

    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || (e.target as HTMLElement).classList.contains('lb-figure')) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    dlg.addEventListener('close', () => opener?.focus());
  }

  // --- YouTube: só carrega o player quando a pessoa clica (página mais leve) ---
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((b) => {
    b.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = b.dataset.title ?? 'Vídeo do YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      // estilo inline: elementos criados via JS não recebem o CSS com escopo do Astro
      Object.assign(iframe.style, { width: '100%', aspectRatio: '16 / 9', border: '0', borderRadius: '0.9rem' });
      b.replaceWith(iframe);
    });
  });
</script>
