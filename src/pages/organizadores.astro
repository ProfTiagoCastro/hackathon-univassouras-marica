---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import OrganizersGrid from '../components/organizers/OrganizersGrid.astro';
import RegisterCta from '../components/RegisterCta.astro';
import { organizers, partners } from '../data/organizers';
---

<BaseLayout
  title="Organizadores"
  description="Conheça os professores de Engenharia de Software e ADS da Univassouras Maricá que organizam o Hackathon 2026 e a parceria com o Hackenf FACMAR."
>
  <section class="pt-32 pb-12 sm:pt-40" aria-labelledby="org-title">
    <div class="shell">
      <SectionTitle id="org-title" eyebrow="Organizadores" title="Os professores por trás do Hackathon" />
      <OrganizersGrid items={organizers} />
    </div>
  </section>

  {
    partners.length > 0 && (
      <section class="pt-12 pb-12 sm:pt-16" aria-labelledby="parceria-title">
        <div class="shell">
          <div class="trace mb-14 sm:mb-16" aria-hidden="true" />
          <SectionTitle id="parceria-title" eyebrow="Enfermagem · FACMAR" title="Parceria Hackenf FACMAR" align="center" />
          <OrganizersGrid items={partners} single partner />
        </div>
      </section>
    )
  }

  <RegisterCta />
</BaseLayout>
