---
import { Image } from 'astro:assets';
import univassouras from '../../assets/logos/univassouras-marica.png';
import facmar from '../../assets/logos/facmar.png';
import { event } from '../../data/event';
import { sponsors } from '../../data/sponsors';
---

<footer class="relative mt-24 border-t border-white/8 bg-ink/80 backdrop-blur-sm">
  <div class="trace absolute inset-x-0 top-0" aria-hidden="true"></div>

  {
    sponsors.length > 0 && (
      <section class="shell sponsors" aria-labelledby="apoio-title">
        <h2 id="apoio-title" class="sponsors-title">Apoio</h2>
        <ul class="sponsor-list" role="list">
          {sponsors.map((s) => (
            <li style={`--s:${s.scale}`}>
              {s.url ? (
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="sponsor" title={`${s.name} (${s.url.includes('instagram.com') ? 'Instagram' : 'site'})`}>
                  <Image src={s.logo} alt={s.name} height={120} class="sponsor-logo" />
                  <span class="sr-only">
                    {s.url.includes('instagram.com') ? 'no Instagram' : 'site'} (abre em nova aba)
                  </span>
                </a>
              ) : (
                <span class="sponsor">
                  <Image src={s.logo} alt={s.name} height={120} class="sponsor-logo" />
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="shell grid gap-10 py-14 md:grid-cols-[1.4fr_1fr] md:items-end">
    <div>
      <!-- logos institucionais, separadas por uma trilha de circuito vertical -->
      <div class="logos">
        <Image src={univassouras} alt="Univassouras: Campus Universitário de Maricá" height={80} class="logo logo--univ" />
        <span class="logo-trace" aria-hidden="true"></span>
        <Image src={facmar} alt="FACMAR: Faculdade de Ciências Médicas de Maricá" height={128} class="logo logo--facmar" />
      </div>
      <p class="mt-6 max-w-md text-sm text-stone">
        Evento organizado pelos professores e pela coordenação dos cursos de {event.courses[0]}, {event.courses[1]} e Enfermagem.
      </p>
    </div>
    <div class="font-mono text-xs leading-relaxed text-stone md:text-right">
      <p class="text-paper">{event.name}</p>
      <p>19 · 20 · 21 de outubro de 2026</p>
      <p>{event.location.name}</p>
      <p class="mt-4 text-stone">&copy; 2026 Universidade de Vassouras</p>
    </div>
  </div>
</footer>

<style>
  /* Faixa de apoiadores: logos pequenas, todas na cor paper, separadas do rodapé por uma linha tracejada */
  .sponsors {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem 2.5rem;
    padding-top: 2.5rem;
    padding-bottom: 2.25rem;
    border-bottom: 1px dashed rgb(255 255 255 / 0.08);
  }
  .sponsors-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-stone);
  }
  .sponsor-list {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.25rem;
  }
  .sponsor {
    display: block;
    padding: 0.25rem;
    border-radius: 0.5rem;
  }
  .sponsor-logo {
    width: auto;
    height: calc(2.25rem * var(--s, 1));
    opacity: 0.72;
    transition: opacity 0.2s ease;
  }
  .sponsor:hover .sponsor-logo,
  .sponsor:focus-visible .sponsor-logo {
    opacity: 1;
  }
  @media (min-width: 640px) {
    .sponsors {
      flex-direction: row;
      align-items: center;
    }
    .sponsor-logo {
      height: calc(2.75rem * var(--s, 1));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sponsor-logo {
      transition: none;
    }
  }

  .logos {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.5rem);
  }
  /* alturas diferentes para equilibrar o peso visual (a Univassouras é mais alongada) */
  .logo {
    width: auto;
    max-width: 100%;
  }
  .logo--univ {
    height: 2rem;
  }
  .logo--facmar {
    height: 3rem;
  }
  @media (min-width: 640px) {
    .logo--univ {
      height: 2.5rem;
    }
    .logo--facmar {
      height: 3.75rem;
    }
  }
  .logo-trace {
    position: relative;
    flex-shrink: 0;
    width: 1px;
    height: 3.25rem;
    background: linear-gradient(var(--color-rose), var(--color-sky));
    opacity: 0.7;
  }
  .logo-trace::before,
  .logo-trace::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 7px;
    height: 7px;
    translate: -50% 0;
    border: 1.5px solid var(--color-rose);
    border-radius: 999px;
    background: var(--color-ink);
  }
  .logo-trace::before {
    top: -4px;
  }
  .logo-trace::after {
    bottom: -4px;
    border-color: var(--color-sky);
  }
</style>
