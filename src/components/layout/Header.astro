---
import RegisterButton from '../ui/RegisterButton.astro';

const links = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#programacao', label: 'Programação' },
  { href: '/organizadores', label: 'Organizadores' },
  { href: '/#local', label: 'Local' },
  { href: '/#faq', label: 'FAQ' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label="Hackathon Univassouras: página inicial">
      <span class="font-display text-xl font-bold tracking-wide">
        <span class="text-rose">HACK</span><span class="text-sky">ATHON</span>
      </span>
      <span class="hidden border-l border-white/15 pl-3 font-mono text-[0.65rem] leading-tight tracking-widest text-stone uppercase sm:block">
        Univassouras<br />Maricá · 2026
      </span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav-link" aria-current={l.href === path ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <span class="hidden sm:block"><RegisterButton size="sm" /></span>
      <button
        type="button"
        class="menu-btn lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
      >
        <span class="sr-only">Abrir menu</span>
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Principal (celular)" class="mobile-menu lg:hidden" hidden data-menu>
    <ul class="shell flex flex-col gap-1 pb-6">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-lg px-3 py-3 font-display text-lg tracking-wide hover:bg-white/5" aria-current={l.href === path ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li class="mt-3 px-3"><RegisterButton size="sm" /></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    transition:
      background-color 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scrolled],
  .site-header[data-open] {
    background: color-mix(in oklab, var(--color-ink) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: rgb(255 255 255 / 0.07);
  }
  .nav-link {
    position: relative;
    display: block;
    padding: 0.5rem 0.85rem;
    font-size: 0.875rem;
    color: color-mix(in oklab, var(--color-paper) 78%, transparent);
    transition: color 0.2s;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-paper);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.2rem;
    height: 1px;
    background: var(--color-rose);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .menu-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0 10px;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 10px;
  }
  @media (min-width: 64rem) {
    .menu-btn {
      display: none;
    }
  }
  .menu-btn .bar {
    height: 1.5px;
    background: var(--color-paper);
    transition: transform 0.3s var(--ease-out-expo), opacity 0.2s;
  }
  .menu-btn[aria-expanded='true'] .bar:nth-child(2) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .bar:nth-child(3) {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] .bar:nth-child(4) {
    transform: translateY(-6.5px) rotate(-45deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!btn || !menu || !header) return;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.sr-only')!.textContent = open ? 'Fechar menu' : 'Abrir menu';
    menu.hidden = !open;
    header.toggleAttribute('data-open', open);
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });
</script>
