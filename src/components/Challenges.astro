---
/**
 * Os 11 desafios do edital, separados pelas categorias de premiação (Software e IoT).
 * Cada linha mostra só número, nome e nível; a área e o resumo abrem ao tocar (<details>).
 * Abaixo, os critérios da banca em barras compactas.
 * Dados em src/data/challenges.ts.
 */
import SectionTitle from './ui/SectionTitle.astro';
import { challenges, categories, levels, criteria, tieBreakNote, type Category } from '../data/challenges';

const groups = (Object.keys(categories) as Category[]).map((c) => ({
  id: c,
  ...categories[c],
  items: challenges.filter((ch) => ch.category === c),
}));
const maxWeight = Math.max(...criteria.map((c) => c.weight));
---

<section id="desafios" class="py-20 sm:py-28" aria-labelledby="desafios-title">
  <div class="shell">
    <SectionTitle
      id="desafios-title"
      eyebrow="Desafios"
      title="Onze problemas reais para escolher"
      lead="Na inscrição, a equipe indica três desafios em ordem de preferência. Toque num desafio para ver do que se trata."
    />

    <div class="grid gap-6 lg:grid-cols-2">
      {
        groups.map((g) => (
          <article class="panel p-6 sm:p-8" aria-labelledby={`cat-${g.id}`}>
            <h3 id={`cat-${g.id}`} class="font-display text-2xl font-bold">{g.label}</h3>
            <p class="mt-1 text-sm text-pretty text-stone">{g.note}</p>

            <ul class="ch-list" role="list">
              {g.items.map((ch) => (
                <li>
                  <details class="ch">
                    <summary class="ch-head">
                      <span class="ch-pad" aria-hidden="true">{ch.n}</span>
                      <span class="ch-title">
                        <span class="sr-only">Desafio {ch.n}: </span>
                        {ch.title}
                      </span>
                      <span class="ch-level" data-rank={levels[ch.level].rank} title={`Nível ${levels[ch.level].label}`}>
                        <span class="lv-dots" aria-hidden="true"><i /><i /><i /></span>
                        <span class="sr-only">Nível {levels[ch.level].label}</span>
                      </span>
                      <svg class="ch-chev" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                    </summary>
                    <div class="ch-body">
                      <p class="ch-area">{ch.area}, nível {levels[ch.level].label.toLowerCase()}</p>
                      <p class="mt-1 text-sm text-pretty text-paper/80">{ch.summary}</p>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- legenda dos níveis: uma linha só, no lugar da nota de rodapé -->
    <p class="lv-legend" aria-hidden="true">
      <span class="ch-level" data-rank="1"><span class="lv-dots"><i /><i /><i /></span>Básico</span>
      <span class="ch-level" data-rank="2"><span class="lv-dots"><i /><i /><i /></span>Intermediário</span>
      <span class="ch-level" data-rank="3"><span class="lv-dots"><i /><i /><i /></span>Avançado</span>
      <span class="text-stone">Nível indicado pelo edital, só como orientação.</span>
    </p>

    <article class="panel mt-10 grid gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_1.5fr] lg:items-center" aria-labelledby="criterios-title">
      <div>
        <h3 id="criterios-title" class="font-display text-2xl font-bold">Como a banca avalia</h3>
        <p class="mt-3 text-pretty text-paper/80">
          7 minutos de apresentação com demonstração ao vivo e 5 de arguição técnica. Cada critério vale de 0 a 10, com o peso ao lado.
        </p>
      </div>

      <div>
        <ol class="crit-list" role="list">
          {
            criteria.map((c) => (
              <li class="crit" title={c.detail}>
                <span class="crit-name">{c.name}</span>
                <span class="crit-track" aria-hidden="true">
                  <span class="crit-bar" style={`--w:${(c.weight / maxWeight) * 100}%`} />
                </span>
                <span class="crit-weight">
                  {c.weight}%<span class="sr-only"> da nota</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="mt-4 text-xs text-pretty text-stone">{tieBreakNote}</p>
      </div>
    </article>
  </div>
</section>

<style>
  .ch-list {
    margin-top: 1.25rem;
  }
  .ch {
    border-top: 1px dashed rgb(255 255 255 / 0.08);
  }
  .ch-head {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto 1rem;
    gap: 0.85rem;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.55rem 0;
    cursor: pointer;
    list-style: none;
  }
  .ch-head::-webkit-details-marker {
    display: none;
  }
  .ch-pad {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--color-rose);
    border-radius: 999px;
    background: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  li:nth-child(even) .ch-pad {
    border-color: var(--color-sky);
  }
  .ch-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: pretty;
  }
  .ch-head:hover .ch-title {
    color: var(--color-rose);
  }
  .ch-chev {
    color: var(--color-stone);
    transition: rotate 0.2s var(--ease-out-expo);
  }
  .ch[open] .ch-chev {
    rotate: 180deg;
  }
  .ch-body {
    padding: 0 0 1rem 3.1rem;
  }
  .ch-area {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-sky);
  }

  /* Nível: três pads acesos conforme a dificuldade (o nome do nível vai para leitores de tela e para o resumo aberto) */
  .ch-level {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .lv-dots {
    display: inline-flex;
    gap: 3px;
  }
  .lv-dots i {
    width: 8px;
    height: 8px;
    border: 1.5px solid color-mix(in oklab, var(--color-stone) 60%, transparent);
    border-radius: 999px;
  }
  [data-rank='1'] .lv-dots i:nth-child(-n + 1),
  [data-rank='2'] .lv-dots i:nth-child(-n + 2),
  [data-rank='3'] .lv-dots i {
    border-color: var(--color-rose);
    background: var(--color-rose);
  }
  .lv-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-paper);
  }

  /* Critérios: nome · barra · peso numa linha só */
  .crit-list {
    display: grid;
    gap: 0.8rem;
  }
  .crit {
    display: grid;
    grid-template-columns: minmax(0, 15rem) 1fr 2.75rem;
    gap: 1rem;
    align-items: center;
  }
  .crit-name {
    font-size: 0.95rem;
  }
  .crit-weight {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .crit-track {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--color-ink-3);
  }
  .crit-bar {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-wine), var(--color-rose));
  }
  @media (max-width: 560px) {
    .crit {
      grid-template-columns: 1fr 2.75rem;
      gap: 0.35rem 1rem;
    }
    .crit-track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch-chev {
      transition: none;
    }
  }
</style>
