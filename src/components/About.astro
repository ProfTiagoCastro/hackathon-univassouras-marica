---
import SectionTitle from './ui/SectionTitle.astro';
import UnderConstruction from './ui/UnderConstruction.astro';
import { event } from '../data/event';
import { rules, prizes, prizesNote } from '../data/faq';

const specs: { k: string; v: string | null }[] = [
  { k: 'quando', v: '19, 20 e 21 de outubro de 2026' },
  { k: 'onde', v: event.location.name },
  { k: 'cursos', v: `${event.courses[0]} · ${event.courses[1]}` },
  { k: 'público', v: 'Estudantes de ESW e ADS · até 2 por equipe de outros cursos' },
  { k: 'formato', v: 'Equipes de 3 a 5 · protótipo funcional em 3 dias' },
  { k: 'desafios', v: '11 desafios · categorias Software e IoT' },
  { k: 'contato', v: event.contact },
];
---

<section id="sobre" class="py-20 sm:py-28" aria-labelledby="sobre-title">
  <div class="shell">
    <SectionTitle
      id="sobre-title"
      eyebrow="Sobre o evento"
      title="Três dias para tirar uma ideia do papel"
      lead="Uma maratona de três dias em que equipes de estudantes desenvolvem protótipos funcionais de software (aplicativos, sistemas web, jogos e soluções de IoT) para problemas reais de Maricá e de áreas parceiras, com mentoria dos professores."
    />

    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr]">
      <!-- ficha técnica do evento -->
      <dl class="panel spec self-start p-6 font-mono text-sm sm:p-8 lg:sticky lg:top-24">
        <p class="mb-5 text-xs tracking-[0.2em] text-stone uppercase" aria-hidden="true">hackathon.config</p>
        {
          specs.map((s) => (
            <div class="spec-row">
              <dt class="text-sky">{s.k}</dt>
              <dd class="min-w-0 break-words">
                {s.v === null ? (
                  <UnderConstruction />
                ) : s.k === 'contato' ? (
                  <a href={`mailto:${s.v}`} class="text-sky underline underline-offset-4 [overflow-wrap:anywhere] hover:text-paper">{s.v}</a>
                ) : (
                  s.v
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="grid gap-6">
        <article class="panel p-6 sm:p-8" aria-labelledby="regras-title">
          <h3 id="regras-title" class="font-display text-2xl font-bold">Regras</h3>
          {
            rules.length ? (
              <ul class="mt-4 space-y-2 text-paper/85">
                {rules.map((r) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-rose" />
                    {r}
                  </li>
                ))}
              </ul>
            ) : (
              <UnderConstruction variant="block" class="mt-4" hint="O regulamento completo será publicado aqui." />
            )
          }
        </article>

        <article class="panel p-6 sm:p-8" aria-labelledby="premiacao-title">
          <h3 id="premiacao-title" class="font-display text-2xl font-bold">Premiação</h3>
          {
            prizes.length ? (
              <>
                <ol class="mt-4 space-y-2">
                  {prizes.map((p) => (
                    <li class="flex justify-between gap-4 border-b border-white/8 pb-2">
                      <span class="shrink-0 font-display font-bold text-rose">{p.place}</span>
                      <span class="text-right text-paper/85">{p.prize}</span>
                    </li>
                  ))}
                </ol>
                <p class="mt-4 flex flex-wrap items-center gap-2 text-sm text-stone">
                  <UnderConstruction label="Valores a definir" /> {prizesNote}
                </p>
              </>
            ) : (
              <UnderConstruction variant="block" class="mt-4" hint="Os prêmios das equipes vencedoras serão divulgados em breve." />
            )
          }
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .spec-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 0;
    border-top: 1px dashed rgb(255 255 255 / 0.08);
  }
  .spec-row dd {
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
  .spec-row dt::after {
    content: ':';
    color: var(--color-stone);
  }
  @media (max-width: 480px) {
    .spec-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
