---
/**
 * Grade de cartões de professores + lógica de "fixar" o cartão virado.
 * Pode haver mais de uma grade na página (equipe do Hackathon e parceria HackEnf);
 * a lógica vale para todos os cartões da página de uma vez.
 * Regras:
 *  - clique/toque num cartão → fica fixado virado (e solta qualquer outro)
 *  - clique/toque de novo no mesmo cartão → desvira
 *  - clique fora de qualquer cartão ou tecla Esc → solta
 *  (no computador, o hover continua virando o cartão enquanto o mouse está em cima)
 */
import OrganizerCard from './OrganizerCard.astro';
import type { Organizer } from '../../data/organizers';

interface Props {
  items: Organizer[];
  /** cartão único, centralizado (ex.: parceria) */
  single?: boolean;
  /** tom azul da parceria HackEnf */
  partner?: boolean;
}
const { items, single = false, partner = false } = Astro.props;
---

<ul class:list={['org-grid', single && 'org-grid--single']} data-org-grid role="list">
  {items.map((o, i) => <OrganizerCard organizer={o} index={i} partner={partner} />)}
</ul>

<style is:global>
  /* colunas fixas por largura (1 / 2 / 3) para saber quando o último cartão sobra sozinho */
  .org-grid {
    --org-gap: clamp(1rem, 2.5vw, 1.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--org-gap);
  }
  @media (min-width: 40rem) {
    .org-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* 2 colunas: último cartão sozinho fica centralizado, com a largura de uma coluna */
    .org-grid:not(.org-grid--single) > li:last-child:nth-child(2n + 1) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc((100% - var(--org-gap)) / 2);
    }
  }
  @media (min-width: 64rem) {
    /* 3 cartões por linha sobre 6 trilhas: cada cartão ocupa 2, o que permite centralizar
       a última linha quando sobram 1 ou 2 cartões */
    .org-grid:not(.org-grid--single) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .org-grid:not(.org-grid--single) > li {
      grid-column: span 2;
    }
    .org-grid:not(.org-grid--single) > li:last-child:nth-child(2n + 1) {
      grid-column: span 2;
      justify-self: stretch;
      width: auto;
    }
    /* sobra 1: vai para o meio */
    .org-grid:not(.org-grid--single) > li:last-child:nth-child(3n + 1) {
      grid-column: 3 / span 2;
    }
    /* sobram 2: o primeiro deles começa na trilha 2, e o par fica centralizado */
    .org-grid:not(.org-grid--single) > li:nth-last-child(2):nth-child(3n + 1) {
      grid-column: 2 / span 2;
    }
  }
  /* um cartão só: mesma largura de uma coluna da grade principal, centralizado */
  .org-grid--single {
    grid-template-columns: minmax(0, 22rem);
    justify-content: center;
  }
  /* destaque: os outros cartões recuam quando um está em foco/fixado */
  .org-grid:has(.org-card[data-pinned]) .org-card:not([data-pinned]) {
    opacity: 0.45;
    filter: grayscale(0.5);
  }
  @media (hover: hover) {
    .org-grid:has(.org-card:hover) .org-card:not(:hover):not([data-pinned]) {
      opacity: 0.45;
      filter: grayscale(0.5);
    }
  }
</style>

<script>
  const grids = [...document.querySelectorAll<HTMLElement>('[data-org-grid]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-org-card]')];

  if (cards.length) {
    const setPinned = (card: HTMLElement | null) => {
      for (const c of cards) {
        const on = c === card;
        c.toggleAttribute('data-pinned', on);
        c.querySelector('[data-flip-btn]')?.setAttribute('aria-pressed', String(on));
      }
    };

    for (const card of cards) {
      card.addEventListener('click', (e) => {
        // clicar no link do Lattes não desvira o cartão
        if ((e.target as HTMLElement).closest('a')) return;
        setPinned(card.hasAttribute('data-pinned') ? null : card);
      });
    }

    // clique/toque fora de qualquer cartão solta o fixado
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('[data-org-card]')) setPinned(null);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setPinned(null);
    });

    // entrada escalonada de cada grade ao aparecer na tela
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            en.target.classList.add('is-in');
            io.unobserve(en.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    grids.forEach((g) => io.observe(g));
  }
</script>
