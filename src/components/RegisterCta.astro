---
import RegisterButton from './ui/RegisterButton.astro';
import { event, hasRegistration, registrationClosed } from '../data/event';
---

<section id="inscricao" class="py-20 sm:py-28" aria-labelledby="inscricao-title">
  <div class="shell">
    <div class="cta-band">
      <div class="relative z-10 grid gap-8 md:grid-cols-[1.4fr_auto] md:items-center">
        <div>
          <p class="eyebrow">Inscrição</p>
          <h2 id="inscricao-title" class="mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-5xl">
            {registrationClosed ? 'As inscrições foram encerradas' : 'Garanta sua vaga no Hackathon'}
          </h2>
          <p class="mt-4 max-w-xl text-pretty text-paper/80">
            {
              registrationClosed
                ? 'Obrigado a todas as equipes inscritas. Acompanhe a programação e, durante o evento, as fotos no Mural.'
                : hasRegistration
                  ? 'Gratuita, por um formulário do Google, para equipes formadas ou para quem ainda está sem equipe.'
                  : 'A inscrição será feita por um formulário do Google, que será publicado aqui em breve. Volte nesta página para se inscrever.'
            }
          </p>
          {hasRegistration && <p class="mt-3 font-display text-lg font-bold text-rose">Inscrições {event.registrationPeriod.replace(' de 2026', '')}</p>}
        </div>
        <div class="flex flex-col items-start gap-4 md:items-center">
          <!-- com as inscrições encerradas o título já diz tudo; o botão apagado aqui só repetiria -->
          {!registrationClosed && <RegisterButton />}
          <a href={event.edital.url} download class="edital-link">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" /></svg>
            Baixar o edital
            <span class="inline-block text-stone">(PDF, {event.edital.size})</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .edital-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-sky);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .edital-link:hover {
    color: var(--color-paper);
  }
  .cta-band {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid color-mix(in oklab, var(--color-rose) 30%, transparent);
    background:
      linear-gradient(115deg, color-mix(in oklab, var(--color-wine) 55%, transparent), transparent 55%),
      linear-gradient(295deg, color-mix(in oklab, var(--color-navy) 70%, transparent), transparent 60%),
      var(--color-ink-2);
    /* mesmo recorte angular da faixa "IDEIAS QUE TRANSFORMAM" */
    clip-path: polygon(28px 0, 100% 0, 100% calc(100% - 28px), calc(100% - 28px) 100%, 0 100%, 0 28px);
  }
  .cta-band::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(90deg, transparent, #000 60%);
  }
</style>
