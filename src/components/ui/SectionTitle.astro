---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, lead, id, align = 'left' } = Astro.props;
---

<header class:list={['mb-10 sm:mb-14', align === 'center' && 'mx-auto max-w-2xl text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h2>
  {lead && <p class:list={['mt-4 max-w-2xl text-base text-pretty text-stone sm:text-lg', align === 'center' && 'mx-auto']}>{lead}</p>}
</header>
