---
/**
 * Programação em abas (um dia por aba). Cada atividade é um "pad" numa trilha de circuito.
 * Dados em src/data/schedule.ts.
 */
import SectionTitle from './ui/SectionTitle.astro';
import UnderConstruction from './ui/UnderConstruction.astro';
import DayTabs from './ui/DayTabs.astro';
import { Image } from 'astro:assets';
import { schedule, activityTypes, scheduleNote } from '../data/schedule';

const kindLabel = { palestra: 'Palestra', minicurso: 'Minicurso', banca: 'Banca avaliadora' } as const;

/** "Sandro Carvalho" → "SC" (avatar de quem ainda não tem foto) */
const initials = (name: string) => {
  const parts = name.trim().split(/\s+/);
  return ((parts[0]?.[0] ?? '') + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
};
---

<section id="programacao" class="py-20 sm:py-28" aria-labelledby="programacao-title">
  <div class="shell">
    <SectionTitle
      id="programacao-title"
      eyebrow="Programação"
      title="Dia a dia do Hackathon"
    />

    <div>
      <DayTabs days={schedule} prefix="prog" />

      {
        schedule.map((d, i) => (
          <div role="tabpanel" id={`prog-panel-${d.id}`} aria-labelledby={`prog-tab-${d.id}`} tabindex="0" hidden={i !== 0} class="panel day-panel">
            <header class="mb-8 flex flex-wrap items-center justify-between gap-3">
              <h3 class="font-display text-2xl font-bold sm:text-3xl">
                {d.weekday}, {d.date.slice(8)} de outubro
              </h3>
              {d.theme ? <p class="font-mono text-sm text-sky">{d.theme}</p> : <UnderConstruction label="Horários em construção" />}
            </header>

            <ol class="timeline">
              {d.activities.length
                ? d.activities.map((a) => (
                    <li class="tl-item" data-type={a.type}>
                      <span class="tl-pad" aria-hidden="true" />
                      <time class="tl-time">
                        {a.start}
                        {a.end && <span class="text-stone"> – {a.end}</span>}
                      </time>
                      <div>
                        <p class="tl-type">{activityTypes[a.type].label}</p>
                        <p class="tl-title">{a.title}</p>
                        {a.description && <p class="mt-1 text-sm text-stone">{a.description}</p>}
                      </div>
                    </li>
                  ))
                : [0, 1, 2].map((k) => (
                    <li class="tl-item tl-ghost" aria-hidden={k > 0 ? 'true' : undefined}>
                      <span class="tl-pad" aria-hidden="true" />
                      <span class="tl-time text-stone">--:--</span>
                      <div class="w-full">
                        {k === 0 ? (
                          <p class="text-paper/80">As atividades deste dia ainda estão sendo definidas pela organização.</p>
                        ) : (
                          <>
                            <span class="ghost-bar w-2/5" />
                            <span class="ghost-bar mt-2 w-3/5 opacity-60" />
                          </>
                        )}
                      </div>
                    </li>
                  ))}
            </ol>

            {d.talks.length > 0 && (
              <div class="talks">
                <h4 class="talks-title">Palestras e minicursos do dia</h4>
                <ul class="talk-grid" role="list">
                  {d.talks.map((t) => (
                    <li class:list={['talk', `talk--${t.kind}`]}>
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <span class="talk-kind">{kindLabel[t.kind]}</span>
                        <span class="talk-time">{t.time ?? 'Horário a definir'}</span>
                      </div>
                      {t.title ? <p class="talk-name">{t.title}</p> : (
                        <p class="talk-name talk-name--tbd">
                          Título em definição <UnderConstruction class="ml-1 align-middle" />
                        </p>
                      )}
                      <div class="talk-person">
                        <span class="avatar" aria-hidden={t.photo ? undefined : 'true'}>
                          {t.photo ? (
                            <Image src={t.photo} alt={`Foto de ${t.speaker}`} widths={[64, 128, 192]} sizes="64px" class="avatar-img" />
                          ) : t.kind === 'banca' ? (
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                          ) : (
                            <span class="avatar-initials">{initials(t.speaker)}</span>
                          )}
                        </span>
                        <p class="talk-speaker">
                          <span class="talk-role">{t.role}</span>
                          {t.speaker}
                        </p>
                      </div>
                      <p class="talk-place">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span class="sr-only">Local:</span> {t.location ?? 'Local a definir'}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
      <p class="mt-4 font-mono text-xs text-stone">* {scheduleNote}</p>
    </div>
  </div>
</section>

<style>
  /* Linha do tempo como trilha de circuito */
  .timeline {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: linear-gradient(var(--color-rose), var(--color-sky));
    opacity: 0.55;
  }
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 8.25rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0 0.9rem 2.25rem;
    border-radius: 0.75rem;
  }
  .tl-pad {
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-rose);
    border-radius: 999px;
    background: var(--color-ink);
  }
  .tl-item:nth-child(even) .tl-pad {
    border-color: var(--color-sky);
  }
  .tl-time {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    padding-top: 0.05rem;
    font-variant-numeric: tabular-nums;
  }
  .tl-type {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-sky);
  }
  .tl-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .tl-ghost .tl-pad {
    border-style: dashed;
  }
  /* Palestras e minicursos do dia */
  .talks {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px dashed rgb(255 255 255 / 0.1);
  }
  .talks-title {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-rose);
  }
  .talk-grid {
    display: grid;
    gap: 0.85rem;
  }
  @media (min-width: 48rem) {
    .talk-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .talk {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.2rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-left: 3px solid var(--color-rose);
    border-radius: 0.85rem;
    background: color-mix(in oklab, var(--color-ink) 55%, transparent);
  }
  .talk--minicurso {
    border-left-color: var(--color-sky);
  }
  .talk--banca {
    border-left-color: var(--color-stone);
  }
  .talk-kind {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-sky);
  }
  .talk-time {
    padding: 0.15rem 0.55rem;
    border: 1px dashed color-mix(in oklab, var(--color-stone) 45%, transparent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--color-stone);
  }
  .talk-name {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: pretty;
  }
  .talk-name--tbd {
    color: var(--color-stone);
  }
  /* Palestrante: avatar redondo como um "pad" de circuito, na cor do tipo da atividade */
  .talk {
    --ring: var(--color-rose);
  }
  .talk--minicurso {
    --ring: var(--color-sky);
  }
  .talk--banca {
    --ring: var(--color-stone);
  }
  .talk-person {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.15rem;
  }
  .avatar {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    padding: 3px;
    border: 2px solid var(--ring);
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--ring);
  }
  /* ponto de solda ligando o pad ao cartão */
  .avatar::after {
    content: '';
    position: absolute;
    right: -1px;
    bottom: 3px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--ring);
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    object-fit: cover;
  }
  .avatar-initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--ring) 16%, var(--color-ink));
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-paper);
  }
  .talk-speaker {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-paper);
  }
  .talk-role {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-stone);
  }
  .talk-place {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-sky);
  }
  .talk-place svg {
    flex: none;
  }

  .ghost-bar {
    display: block;
    height: 0.8rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.06));
    background-size: 200% 100%;
    animation: shimmer 2.4s linear infinite;
  }
  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }
  @media (max-width: 560px) {
    .tl-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ghost-bar {
      animation: none;
    }
  }
</style>
