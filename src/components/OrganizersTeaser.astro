---
import { Image } from 'astro:assets';
import { organizers } from '../data/organizers';

const confirmed = organizers.filter((o) => o.name);
---

<section class="py-20 sm:py-24" aria-labelledby="teaser-title">
  <div class="shell">
    <a href="/organizadores" class="teaser group">
      <div>
        <p class="eyebrow">Organizadores</p>
        <h2 id="teaser-title" class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">Conheça os professores que organizam o evento</h2>
        <p class="mt-3 text-stone">{organizers.length} professores dos cursos de Engenharia de Software e ADS.</p>
      </div>
      <div class="flex items-center gap-5">
        <div class="flex -space-x-3" aria-hidden="true">
          {
            organizers.slice(0, 6).map((o) =>
              o.photo ? (
                <Image src={o.photo} alt="" width={96} height={96} class="avatar" />
              ) : (
                <span class="avatar avatar--empty">?</span>
              ),
            )
          }
        </div>
        <span class="arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </div>
      <span class="sr-only">Ver todos os organizadores ({confirmed.length} confirmados)</span>
    </a>
  </div>
</section>

<style>
  .teaser {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 1.5rem;
    background: color-mix(in oklab, var(--color-ink-2) 70%, transparent);
    transition: border-color 0.3s, background-color 0.3s;
  }
  .teaser:hover {
    border-color: color-mix(in oklab, var(--color-rose) 50%, transparent);
  }
  .avatar {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    border: 2px solid var(--color-ink);
    object-fit: cover;
  }
  .avatar--empty {
    display: grid;
    place-items: center;
    background: var(--color-ink-3);
    font-family: var(--font-mono);
    color: var(--color-stone);
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-wine), var(--color-brick));
    transition: transform 0.4s var(--ease-out-expo);
  }
  .teaser:hover .arrow {
    transform: translateX(4px) rotate(-45deg);
  }
</style>
